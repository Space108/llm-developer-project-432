# OpenAI-совместимый API: Ollama, LM Studio или OpenRouter.
# Пример Ollama: LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=local-model
LLM_CHEAP_MODEL=local-cheap
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_INPUT_PER_1K=0.00015
LLM_OUTPUT_PER_1K=0.0006
LLM_CHEAP_INPUT_PER_1K=0.00005
LLM_CHEAP_OUTPUT_PER_1K=0.0002
CONFIDENCE_THRESHOLD=0.6
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_MODEL=google/embeddinggemma-300m
EMBEDDING_DIMENSIONS=768
EMBEDDING_QUERY_PREFIX="task: search result | query: "
EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
EMBEDDING_BATCH_SIZE=32
RELEVANCE_THRESHOLD=0.40
RRF_K=60
SEARCH_LIMIT=10
CONTEXT_SIZE_LIMIT=12000
INJECTION_BLOCK_THRESHOLD=2
# true: синхронное соединение слоя каркаса применяет недостающие миграции (нужны права на DDL).
# false: только проверяет схему; применять заранее командой `python -m app.core.migrate`.
AUTO_MIGRATE=true
GOLDEN_PATH=data/golden_cards.json
METRICS_REPORT_DIR=data/reports

DATABASE_URL=postgresql+asyncpg://cards:cards@localhost:5432/cards

TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=card-queue
